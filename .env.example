# ============================================================
# Voice RAG System - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit the real .env file.

# --- Sarvam AI (Speech-to-Text) ---
# Get from: https://dashboard.sarvam.ai
SARVAM_API_KEY=sk_your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_STT_ENDPOINT=https://api.sarvam.ai/speech-to-text

# --- LLM (Sarvam AI / Sarvam-105B) ---
LLM_PROVIDER=sarvam
LLM_MODEL=sarvam-105b-conversations
SARVAM_LLM_ENDPOINT=https://api.sarvam.ai/v1/chat/completions
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2

# --- Retrieval / RAG pipeline ---
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.10
RETRIEVAL_CONTEXT_MAX_TOKENS=2048
EMBEDDING_DIM=384
DEFAULT_CHUNKING_STRATEGY=overlapping

# --- Latency targets (ms) ---
TARGET_RETRIEVAL_LATENCY_MS=50
TARGET_PIPELINE_LATENCY_MS=3000

# --- Dataset ---
MSMARCO_XI_SUBSET_SIZE=500
DATASET_PATH=data/msmarco-xi-subset.json

# --- Server ---
PORT=3000
NODE_ENV=development
